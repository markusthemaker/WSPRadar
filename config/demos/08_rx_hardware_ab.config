{
  "format": "wspradar.config",
  "schema_version": 1,
  "profile": {
    "id": "rx_hardware_ab",
    "title": {
      "en": "RX hardware A/B test",
      "de": "RX Hardware-A/B-Test"
    },
    "description": {
      "en": "Runs an RX A/B comparison between DL1MKS and DL1MKS/P on 20m.",
      "de": "Startet einen RX-A/B-Vergleich zwischen DL1MKS und DL1MKS/P auf 20m."
    }
  },
  "settings": {
    "core_parameters": {
      "analysis_direction": "rx",
      "callsign": "DL1MKS",
      "qth": "JN37",
      "band": "20m",
      "time_selection": {
        "start_utc": "2026-04-06T10:00Z",
        "end_utc": "2026-04-06T23:45Z"
      }
    },
    "comparison_parameters": {
      "mode": "hardware_ab",
      "reference_callsign": "DL1MKS/P",
      "snr_correction_mode": "no_offset",
      "snr_correction_db": 0.0
    },
    "advanced_parameters": {
      "solar_state": "all",
      "max_peer_distance_km": 22000,
      "exclude_special_callsigns": false,
      "exclude_moving_stations": false,
      "min_joint_spots_per_station": 1,
      "min_confirmed_opportunities_per_peer": 5,
      "min_joint_stations_per_map_segment": 1
    },
    "results_view": {
      "performance": {
        "selected_ranges": "all",
        "selected_directions": "all",
        "show_zero_target": false,
        "segment_evidence_time_bin": "auto",
        "station_evidence_time_bin": "1h",
        "selected_stations": null
      },
      "benchmark": {
        "selected_ranges": "all",
        "selected_directions": "all",
        "show_non_joint": false,
        "segment_evidence_time_bin": "auto",
        "station_evidence_time_bin": "1h",
        "selected_stations": null
      }
    }
  },
  "extensions": {}
}
