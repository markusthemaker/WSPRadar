{
  "format": "wspradar.config",
  "schema_version": 1,
  "profile": {
    "id": "vanhamel_rx_calibration",
    "title": {
      "en": "#4 Dr. Vanhamel et al. RX Chain Calibration: Calibrating a 1.2 dB Receiver Offset",
      "de": "#4 Dr. Vanhamel et al.: Empfangskette kalibrieren – einen Empfängeroffset von 1,2 dB bestimmen"
    },
    "description": {
      "en": "**RX Benchmark compares two receiving stations.** Compare **ON4AWM0 and ON4AWM1** on **160 m, 6–13 February 2021**, to examine a receiver-chain offset before comparing antennas. The paper describes both receiving chains connected to the same antenna; the database alone does not verify that connection throughout the selected week.\n\nThe demo applies **0.0 dB correction**, leaving the original offset visible. The **+1.2 dB mean across qualifying spot pairs** differs from the **+1.0 dB station-balanced median**.\n\nWe recommend opening the guided demo alongside the app to follow the setup, results, and interpretation step by step.\n\n[Guided Demo & explanation ↗](https://wspradar.org/en/demos/vanhamel_rx_calibration/) · [Original paper ↗](https://doi.org/10.1155/2022/4809313) · [Calibration reconstruction (figure) ↗](https://wspradar.org/assets/demos/vanhamel_rx_calibration/benchmark-evidence.en.png)",
      "de": "**RX Benchmark vergleicht zwei Empfangsstationen.** Vergleiche **ON4AWM0 und ON4AWM1** auf **160 m vom 6.–13. Februar 2021**, um vor einem Antennenvergleich den Offset der Empfangsketten zu untersuchen. Die Publikation beschreibt beide Empfangsketten an derselben Antenne; das Archiv allein bestätigt diese Verbindung nicht für die gesamte ausgewählte Woche.\n\nDie Demo verwendet **0,0 dB Korrektur**, damit der ursprüngliche Offset sichtbar bleibt. Der **Mittelwert von +1,2 dB über qualifizierende Joint Spots** unterscheidet sich vom **stationsgleichgewichteten Median von +1,0 dB**.\n\nWir empfehlen, die geführte Demo parallel zur App zu öffnen, um Aufbau, Ergebnisse und Interpretation Schritt für Schritt nachzuvollziehen.\n\n[Geführte Demo & Erklärung ↗](https://wspradar.org/de/demos/vanhamel_rx_calibration/) · [Originalpublikation ↗](https://doi.org/10.1155/2022/4809313) · [Kalibrierungsrekonstruktion (Abbildung) ↗](https://wspradar.org/assets/demos/vanhamel_rx_calibration/benchmark-evidence.en.png)"
    }
  },
  "settings": {
    "core_parameters": {
      "analysis_direction": "rx",
      "callsign": "ON4AWM0",
      "qth": "JO20OT",
      "band": "160m",
      "time_selection": {
        "start_utc": "2021-02-06T06:00Z",
        "end_utc": "2021-02-13T06:00Z"
      }
    },
    "comparison_parameters": {
      "mode": "reference_station",
      "operation_confirmed": true,
      "reference_callsign": "ON4AWM1",
      "snr_correction_mode": "establish_offset",
      "snr_correction_db": 0.0,
      "reference_qth": "JO20",
      "evidence_mode": "controlled",
      "historical_replay_acknowledged": false
    },
    "advanced_parameters": {
      "solar_state": "all",
      "max_peer_distance_km": 2500,
      "exclude_special_callsigns": false,
      "exclude_moving_stations": false,
      "min_spot_pairs_per_station": 50,
      "min_qualifying_stations_per_map_segment": 1,
      "min_decode_event_share_percent": 1.0,
      "delta_snr_outlier_reporting": false
    },
    "results_view": {
      "benchmark": {
        "selected_ranges": "all",
        "selected_directions": "all",
        "show_unpaired": false,
        "segment_evidence_time_bin": "auto",
        "station_evidence_time_bin": "6h",
        "selected_stations": null
      }
    }
  },
  "extensions": {}
}
