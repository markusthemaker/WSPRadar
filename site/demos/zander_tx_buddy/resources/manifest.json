  "figures": [
    {
      "key": "zander-map",
      "path": "figure_map_highres.dark.png",
      "title": {
        "en": "Map View: a short antenna test reaching Europe and North America",
        "de": "Kartenansicht: Ein kurzer Antennentest erreicht Europa und Nordamerika"
      },
      "caption": {
        "en": "*Sector colors show the typical SNR difference across receiving stations—not simply how far either signal traveled.*",
        "de": "*Die Sektorfarben zeigen die typische SNR-Differenz zwischen Empfangsstationen – nicht einfach, wie weit die Signale gelangten.*"
      },
      "alt": {
        "en": "Azimuthal map of the 20 m comparison centered on SK0WE/P; all populated sectors favor SK0WE/1, with receiver-balanced medians varying by direction and distance.",
        "de": "Azimutalkarte des Vergleichs auf 20 m mit SK0WE/P im Mittelpunkt; alle gefärbten Sektoren sprechen für SK0WE/1. Die stationsgleichgewichteten Mediane variieren mit Richtung und Entfernung."
      },
      "width": 3690,
      "height": 3840,
      "variants": [
        {
          "path": "figure_map_highres.dark-520.webp",
          "width": 520,
          "height": 541
