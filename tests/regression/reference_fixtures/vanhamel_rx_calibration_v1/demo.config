{
  "format": "wspradar.config",
  "schema_version": 1,
  "profile": {
    "id": "vanhamel_rx_calibration",
    "title": {
      "en": "Dr. Vanhamel et al. RX Chain Calibration: Calibrating a 1.2 dB Receiver Offset"
    },
    "description": {
      "en": "[Publication: Vanhamel, J., Machiels, W., & Lamy, H. (2022). Using the WSPR Mode for Antenna Performance Evaluation and Propagation Assessment on the 160-m Band](https://doi.org/10.1155/2022/4809313)\n\nReconstructs a seven-day receiver-chain calibration baseline for 6–13 February 2021 with no SNR correction applied. The paper describes calibration with both receiver chains connected to the same antenna. The 1,143 same-cycle joint reports from the ten transmitters passing the ≥50-joint-report threshold average +1.214 dB for ON4AWM0 − ON4AWM1, displayed as +1.2 dB; each transmitter has a +1.0 dB median. This is consistent with the paper’s 1.2 dB receiver-chain offset and provides the correction used in the WSPRadar antenna-comparison demo. The publication does not identify its calibration dates; this seven-day archive reconstruction is numerically consistent with the paper, while correspondence with its exact original dataset remains unconfirmed."
    }
  },
  "settings": {
    "core_parameters": {
      "analysis_direction": "rx",
      "callsign": "ON4AWM0",
      "qth": "JO20OT",
      "band": "160m",
      "time_selection": {
        "start_utc": "2021-02-06T06:00Z",
        "end_utc": "2021-02-13T06:00Z"
      }
    },
    "comparison_parameters": {
      "mode": "hardware_ab",
      "reference_callsign": "ON4AWM1",
      "snr_correction_mode": "establish_offset",
      "snr_correction_db": 0.0
    },
    "advanced_parameters": {
      "solar_state": "all",
      "max_peer_distance_km": 2500,
      "exclude_special_callsigns": false,
      "exclude_moving_stations": false,
      "min_joint_spots_per_station": 50,
      "min_confirmed_opportunities_per_peer": 5,
      "min_joint_stations_per_map_segment": 1
    },
    "results_view": {
      "performance": {
        "selected_ranges": "all",
        "selected_directions": "all",
        "show_zero_target": false,
        "segment_evidence_time_bin": "auto",
        "station_evidence_time_bin": "6h",
        "selected_stations": null
      },
      "benchmark": {
